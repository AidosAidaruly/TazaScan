generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ServingType {
  per100g
  per100ml
}

enum ProductDataStatus {
  unverified
  community
  verified
}

enum UserRole {
  admin
  user
}

enum ScoreGrade {
  A
  B
  C
  D
  E
}

enum ScoreStatus {
  calculated
  insufficient_data
  requires_review
}

enum ProductSubmissionStatus {
  pending
  approved
  rejected
  needs_correction
}

model Product {
  id             String            @id @default(uuid())
  barcode        String            @unique
  name           String
  brand          String?
  category       String
  ingredients    String[]
  servingType    ServingType
  energyKcal     Float?
  protein        Float?
  carbohydrates  Float?
  sugars         Float?
  fat            Float?
  saturatedFat   Float?
  fiber          Float?
  salt           Float?
  healthScore    Int               @default(0)
  calculatedScore Int?
  calculatedGrade ScoreGrade?
  scoreStatus    ScoreStatus       @default(insufficient_data)
  scoreAlgorithm String?
  scoreVersion   String?
  scoreCalculatedAt DateTime?
  scoreDetails   Json?
  manualScoreOverride Int?
  manualOverrideReason String?
  manualOverrideAt DateTime?
  imageUrl       String?
  dataStatus     ProductDataStatus @default(unverified)
  source         String?
  lastVerifiedAt DateTime?
  submissions    ProductSubmission[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([barcode])
  @@index([name])
  @@index([brand])
  @@index([category])
  @@map("products")
}

model ProductSubmission {
  id                   String                  @id @default(uuid())
  barcode              String?
  name                 String?
  brand                String?
  category             String?
  ingredients          String[]
  servingType          ServingType?
  energyKcal           Float?
  protein              Float?
  carbohydrates        Float?
  sugars               Float?
  fat                  Float?
  saturatedFat         Float?
  fiber                Float?
  salt                 Float?
  frontImageUrl        String?
  ingredientsImageUrl  String?
  nutritionImageUrl    String?
  barcodeImageUrl      String?
  status               ProductSubmissionStatus @default(pending)
  moderationNote       String?
  submittedAt          DateTime                @default(now())
  reviewedAt           DateTime?
  reviewedByUserId     String?
  createdProductId     String?
  anonymousDeviceId    String?

  reviewedByUser       User?                   @relation(fields: [reviewedByUserId], references: [id])
  createdProduct       Product?                @relation(fields: [createdProductId], references: [id])

  @@index([status])
  @@index([barcode])
  @@index([submittedAt])
  @@map("product_submissions")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(user)
  isActive     Boolean  @default(true)
  reviewedSubmissions ProductSubmission[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}
