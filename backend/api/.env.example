NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tazascan?schema=public"
# Comma-separated exact browser origins allowed to call the API with credentials
# (scheme://host[:port], no path or trailing slash; "*" is rejected). Other browser origins get 403;
# requests without an Origin header (mobile app, curl) are unaffected. Empty: local admin origins
# (localhost/127.0.0.1 on 5173 and 4173) in development, none in test, startup error in production.
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
# Number of reverse proxies in front of the API (0 = none, local dev / direct exposure).
# Set to the exact hop count in production, e.g. 1 behind Render/Railway/Fly or one nginx,
# 2 for a CDN in front of nginx. Too low: one shared rate-limit bucket; too high: spoofable IPs.
TRUST_PROXY_HOPS=0
# Required outside tests: at least 32 random characters; placeholders are rejected at startup.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_ACCESS_TOKEN_TTL="15m"
ADMIN_EMAIL="admin@example.com"
# Placeholder rejected by the seed: replace with a unique 12+ character secret before deployment.
# The seed also refuses missing, blank or <12-character values when ADMIN_EMAIL is set.
ADMIN_PASSWORD="change-this-admin-password"
STORAGE_DRIVER=local
# Relative paths resolve against the working directory (start the API from backend/api).
# In production use an absolute path on a persistent disk.
UPLOAD_ROOT=uploads
# Production local storage is only safe when the host provides persistent disk;
# production startup refuses STORAGE_DRIVER=local unless this is true.
ALLOW_LOCAL_PRODUCTION_STORAGE=false
